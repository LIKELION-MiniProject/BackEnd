# passport-ai 환경변수 견본.
# 실제 값은 이 파일을 복사해 ".env" 로 만들어 채운다. (.env 는 git 에 올라가지 않음)

# Google AI Studio 에서 발급한 키
GEMINI_API_KEY=여기에_본인_API_키_붙여넣기

# 사용할 모델명. `python batch.py models` 로 실제 사용 가능한 이름을 확인 후 넣는다.
# 현재 사용: gemini-3.1-flash-lite (무료 하루 ~150회). 폴백 후보: gemini-3.5-flash
GEMINI_MODEL=gemini-3.1-flash-lite
